[Unit]
Description=GhostyCode Telegram Phone Bridge
Wants=network-online.target ghosty-runtime.service
After=network-online.target ghosty-runtime.service

[Service]
Type=simple
User=ghosty
Group=ghosty
WorkingDirectory=/opt/ghosty/telegram-bridge
# Legacy /etc/deepseek is loaded first for old installs; /etc/ghosty wins.
EnvironmentFile=-/etc/deepseek/telegram-bridge.env
EnvironmentFile=-/etc/ghosty/telegram-bridge.env
ExecStart=/usr/bin/node /opt/ghosty/telegram-bridge/src/index.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/ghosty-telegram-bridge

[Install]
WantedBy=multi-user.target
