{
  "name": "ghosty-vscode",
  "displayName": "GhostyCode",
  "description": "Official GhostyCode VS Code integration scaffold for local runtime attach and terminal launch.",
  "version": "0.0.18",
  "publisher": "ghosty",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/blissito/ghostycode.git",
    "directory": "extensions/vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:ghosty.openTerminal",
    "onCommand:ghosty.startRuntime",
    "onCommand:ghosty.checkRuntime",
    "onCommand:ghosty.refreshAgentView",
    "onCommand:ghosty.refreshSnapshots",
    "onCommand:ghosty.openRuntimeDocs",
    "onView:ghosty.runtimeStatus"
  ],
  "main": "./out/extension.js",
  "files": [
    "out",
    "media",
    "README.md",
    "LICENSE"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ghosty.openTerminal",
        "title": "GhostyCode: Open Terminal"
      },
      {
        "command": "ghosty.startRuntime",
        "title": "GhostyCode: Start Local Runtime"
      },
      {
        "command": "ghosty.checkRuntime",
        "title": "GhostyCode: Check Runtime"
      },
      {
        "command": "ghosty.refreshAgentView",
        "title": "GhostyCode: Refresh Agent View"
      },
      {
        "command": "ghosty.refreshSnapshots",
        "title": "GhostyCode: Refresh Restore Points"
      },
      {
        "command": "ghosty.openRuntimeDocs",
        "title": "GhostyCode: Open Runtime API Docs"
      }
    ],
    "configuration": {
      "title": "GhostyCode",
      "properties": {
        "ghosty.commandPath": {
          "type": "string",
          "default": "ghosty",
          "description": "Command or absolute path used to launch GhostyCode."
        },
        "ghosty.runtimeHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Local host used for GhostyCode runtime attach checks."
        },
        "ghosty.runtimePort": {
          "type": "number",
          "default": 7878,
          "minimum": 1,
          "maximum": 65535,
          "description": "Local port used for GhostyCode runtime attach checks."
        },
        "ghosty.runtimeToken": {
          "type": "string",
          "default": "",
          "description": "Optional bearer token for authenticated runtime endpoints."
        },
        "ghosty.agentViewRefreshIntervalSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 0,
          "maximum": 300,
          "description": "Seconds between read-only Agent View refreshes. Set to 0 to disable automatic refresh."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ghosty",
          "title": "GhostyCode",
          "icon": "media/ghosty.svg"
        }
      ]
    },
    "views": {
      "ghosty": [
        {
          "type": "webview",
          "id": "ghosty.runtimeStatus",
          "name": "Agent View"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "check": "npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.7.0",
    "typescript": "^5.9.3"
  }
}
